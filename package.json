{
  "name": "africa-dev-infra",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source provider abstraction infrastructure for African markets",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:gateway": "corepack pnpm --filter @africa-dev/gateway dev",
    "quickstart": "tsx scripts/quickstart.ts",
    "cli": "corepack pnpm --filter @africa-dev/cli exec africa-dev",
    "check": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test && corepack pnpm build"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.8",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4"
  },
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdulrasaq-oniguguru/AfriStack.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/abdulrasaq-oniguguru/AfriStack/issues"
  },
  "homepage": "https://github.com/abdulrasaq-oniguguru/AfriStack#readme"
}
